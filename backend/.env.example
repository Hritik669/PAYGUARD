# Local demo only. Do not use these secrets in production.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://payguard:payguard@localhost:5432/payguard?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=local-demo-access-secret-change-me-32b
JWT_REFRESH_SECRET=local-demo-refresh-secret-change-me-32
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
COOKIE_SECURE=false
WEBHOOK_SANDBOX_SECRET=local-demo-webhook-secret
