TRUST_PROXY=false
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
PAYMENT_RATE_LIMIT_MAX=60
PAYMENT_RATE_LIMIT_WINDOW_SECONDS=60
