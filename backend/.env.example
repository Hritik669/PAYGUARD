# Local demo only. Do not use these secrets in production.
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
# Local Postgres can use the same URL for both. On Neon, DATABASE_URL is the pooled
# connection and DIRECT_URL is the direct connection. Both need sslmode=require on Neon.
DATABASE_URL=postgresql://payguard:payguard@localhost:5432/payguard?schema=public
DIRECT_URL=postgresql://payguard:payguard@localhost:5432/payguard?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=local-demo-access-secret-change-me-32b
JWT_REFRESH_SECRET=local-demo-refresh-secret-change-me-32
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
WEBHOOK_SANDBOX_SECRET=local-demo-webhook-secret
LOG_LEVEL=info
BCRYPT_ROUNDS=10
TRUST_PROXY=false
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
PAYMENT_RATE_LIMIT_MAX=60
PAYMENT_RATE_LIMIT_WINDOW_SECONDS=60
WORKER_CONCURRENCY=4
# ALLOW_DEMO_SEED=true is required only for an explicit production seed. Do not leave it set.
# SEED_REPLACE=true is required to replace an existing demo dataset. It deletes sandbox rows.
